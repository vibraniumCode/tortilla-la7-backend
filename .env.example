MONGODB_URI=mongodb://127.0.0.1:27017/tortillas-al-paso
PORT=4000

# Clave secreta para firmar los tokens de sesión. Cambiala por algo largo
# y aleatorio propio (no la dejes así en producción).
JWT_SECRET=cambiar-esto-por-una-clave-larga-y-secreta

# Notificaciones push web. Generá las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@dominio.com

# Datos del usuario admin que se crea con: npm run crear-admin
# Después de crearlo podés borrar estas dos líneas si querés.
ADMIN_NOMBRE=Dueño
ADMIN_EMAIL=admin@tortillasalpaso.com
ADMIN_PASSWORD=cambiar-esta-clave

# Cuenta de fábrica con permiso para elegir horario de retiro
CLIENTE_ESPECIAL_NOMBRE=Cliente fábrica
CLIENTE_ESPECIAL_EMAIL=fabrica@ejemplo.com
CLIENTE_ESPECIAL_PASSWORD=cambiar-esta-clave

# Cloudinary: se obtienen desde el Dashboard de tu cuenta.
# En Render configurá estos tres valores como variables privadas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

